<Window x:Class="LyricHover.App.Fullscreen.FullscreenLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LyricHover.App.Fullscreen"
        Title="沉浸歌词" WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="#0D0F16" Foreground="White" AllowsTransparency="False" Opacity="0"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed"
        KeyDown="Window_KeyDown" MouseMove="Window_MouseMove" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <StreamGeometry x:Key="PreviousIconGeometry">M 20,6 L 12,12 L 20,18 Z M 12,6 L 4,12 L 12,18 Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIconGeometry">M 7,4 L 20,12 L 7,20 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIconGeometry">M 7,5 L 11,5 L 11,19 L 7,19 Z M 13,5 L 17,5 L 17,19 L 13,19 Z</StreamGeometry>
        <StreamGeometry x:Key="NextIconGeometry">M 4,6 L 12,12 L 4,18 Z M 12,6 L 20,12 L 12,18 Z</StreamGeometry>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="5"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2BFFFFFF"/><Setter Property="BorderBrush" Value="#36FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Margin="2"><Border x:Name="Shadow" Background="#36000000" CornerRadius="999"><Border.RenderTransform><TranslateTransform Y="2"/></Border.RenderTransform></Border>
                    <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#3BFFFFFF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter><Setter TargetName="Shadow" Property="Opacity" Value="0.25"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaybackButton" TargetType="Button">
            <Setter Property="Width" Value="52"/><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Margin="2"><Border x:Name="HoverShadow" Background="Transparent" CornerRadius="999">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverShadow" Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.30" Color="#FFFFFF"/></Setter.Value></Setter></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverShadow" Property="Background" Value="#4A000000"/><Setter TargetName="HoverShadow" Property="Effect" Value="{x:Null}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource PlaybackButton}">
            <Setter Property="Width" Value="62"/><Setter Property="Height" Value="62"/><Setter Property="FontSize" Value="27"/>
        </Style>
        <Style x:Key="LyricHitButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#BFFFFFFF"/><Setter Property="Margin" Value="0,9,0,4"/>
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,3"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#20FFFFFF"/><Setter Property="BorderBrush" Value="#38FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource SettingComboItem}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid x:Name="Root"><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                    <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Path HorizontalAlignment="Right" Margin="0,0,13,0" VerticalAlignment="Center" Fill="#BFFFFFFF" Data="M 0 0 L 4 4 L 8 0 Z"/></Grid></ControlTemplate></ToggleButton.Template></ToggleButton>
                    <ContentPresenter x:Name="SelectionContent" Margin="11,0,34,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False"/>
                    <TextBox x:Name="PART_EditableTextBox" Margin="7,2,34,2" Padding="4,0" VerticalContentAlignment="Center" Foreground="White" Background="Transparent" BorderThickness="0" Visibility="Collapsed" Text="{Binding Text, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" PopupAnimation="Fade"><Border MinWidth="{TemplateBinding ActualWidth}" Margin="0,5,0,0" Padding="5" Background="#EC202025" BorderThickness="0" CornerRadius="12"><Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.38" Color="#000000"/></Border.Effect><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#30FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#7AAFFF"/></Trigger><Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingFontCombo" TargetType="ComboBox" BasedOn="{StaticResource SettingCombo}"><Setter Property="SelectedValuePath" Value="SourceName"/><Setter Property="IsEditable" Value="False"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding DisplayName}" FontFamily="{Binding SourceName}" FontSize="15" TextTrimming="CharacterEllipsis"/></DataTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingComboItem" TargetType="ComboBoxItem"><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemRoot" Background="Transparent" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#2E0A84FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#450A84FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingButton" TargetType="Button"><Setter Property="MinWidth" Value="82"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,0"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#20FFFFFF"/><Setter Property="BorderBrush" Value="#38FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#30FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#3E000000"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingCircleButton" TargetType="Button" BasedOn="{StaticResource SettingButton}"><Setter Property="MinWidth" Value="36"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="CircleShadow" Margin="2,3,2,1" Background="#2A000000" CornerRadius="999"/><Border x:Name="CircleRoot" Margin="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CircleRoot" Property="Background" Value="#32FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="CircleRoot" Property="Background" Value="#48000000"/><Setter TargetName="CircleShadow" Property="Opacity" Value="0.18"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingButton}"><Setter Property="Background" Value="#0A84FF"/><Setter Property="BorderBrush" Value="#0A84FF"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#0071EB"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonRoot" Property="Background" Value="#0064D2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingSlider" TargetType="Slider"><Setter Property="Height" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="30"><Track x:Name="PART_Track" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#0A84FF" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#35FFFFFF" CornerRadius="3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbRoot" Background="White" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="9"><Border.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.25"/></Border.Effect></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbRoot" Property="BorderBrush" Value="#0A84FF"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbRoot" Property="Background" Value="#EAF2FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ChromeSlider" TargetType="Slider"><Setter Property="Height" Value="26"/><Setter Property="UseLayoutRounding" Value="False"/><Setter Property="SnapsToDevicePixels" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="26" UseLayoutRounding="False" SnapsToDevicePixels="False"><Border Height="6" VerticalAlignment="Center" Background="#45FFFFFF" CornerRadius="3"/><Track x:Name="PART_Track" VerticalAlignment="Center" UseLayoutRounding="False" SnapsToDevicePixels="False"><Track.DecreaseRepeatButton><RepeatButton x:Name="PlayedTrackButton" Command="{x:Static Slider.DecreaseLarge}" Focusable="False" UseLayoutRounding="False" SnapsToDevicePixels="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" Background="White" CornerRadius="3" UseLayoutRounding="False" SnapsToDevicePixels="False"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton><Track.Thumb><Thumb Width="12" Height="22" Background="Transparent"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></Grid><ControlTemplate.Triggers><Trigger Property="Value" Value="0"><Setter TargetName="PlayedTrackButton" Property="Opacity" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingCheckBox" TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="CheckRoot" Width="19" Height="19" Background="#20FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1.4" CornerRadius="5"><Path x:Name="CheckGlyph" Width="11" Height="8" Stroke="White" StrokeThickness="2" Data="M 1,4 L 4.2,7 L 10,1" Visibility="Collapsed"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckRoot" Property="Background" Value="#0A84FF"/><Setter TargetName="CheckRoot" Property="BorderBrush" Value="#0A84FF"/><Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckRoot" Property="BorderBrush" Value="#0A84FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingScrollThumb" TargetType="Thumb"><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbVisual" Width="4" Margin="0,4" HorizontalAlignment="Center" Background="White" CornerRadius="2" Opacity="0.28"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbVisual" Property="Width" Value="6"/><Setter TargetName="ThumbVisual" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingScrollBar" TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource SettingScrollThumb}"/></Track.Thumb></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="SettingScrollViewer" TargetType="ScrollViewer"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/><ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="10,5,0,5" Maximum="{TemplateBinding ScrollableHeight}" Orientation="Vertical" Style="{StaticResource SettingScrollBar}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <local:LowResolutionAmbientBackgroundControl x:Name="AmbientBackground"/>
        <Canvas x:Name="SongEffectLayer" Panel.ZIndex="0" ClipToBounds="True" IsHitTestVisible="False" Focusable="False"/>
        <Grid x:Name="ContentRoot" Panel.ZIndex="1" Margin="0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="42*"/><ColumnDefinition x:Name="RightColumn" Width="58*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="TopRow" Height="*"/><RowDefinition x:Name="BottomRow" Height="0"/></Grid.RowDefinitions>

            <Grid x:Name="NowPlayingPanel" Grid.Column="0" Margin="0,18,58,0" MaxWidth="560" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="ArtworkFrame" SnapsToDevicePixels="True">
                    <Border CornerRadius="14" Background="Transparent">
                        <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.22" Color="#000000" Direction="270"/></Border.Effect>
                        <Image x:Name="ArtworkImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock x:Name="TitleText" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ArtistAlbumText" Margin="0,7,0,0" FontSize="16" Foreground="#BFFFFFFF" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,24,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Slider x:Name="ProgressSlider" Style="{StaticResource ChromeSlider}" Minimum="0" Maximum="1" Height="22" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"/>
                    <Grid Grid.Row="1" Margin="2,0"><TextBlock x:Name="PositionText" FontSize="11" Foreground="#9FFFFFFF"/><TextBlock x:Name="DurationText" HorizontalAlignment="Right" FontSize="11" Foreground="#9FFFFFFF"/></Grid>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,19,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PlaybackButton}" Click="Previous_Click" ToolTip="上一首"><Viewbox Width="25" Height="25"><Canvas Width="24" Height="24"><Path Data="{StaticResource PreviousIconGeometry}" Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Click="PlayPause_Click" ToolTip="播放/暂停"><Viewbox Width="29" Height="29"><Canvas Width="24" Height="24"><Path x:Name="PlayPauseIcon" Data="{StaticResource PlayIconGeometry}" Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                    <Button Style="{StaticResource PlaybackButton}" Click="Next_Click" ToolTip="下一首"><Viewbox Width="25" Height="25"><Canvas Width="24" Height="24"><Path Data="{StaticResource NextIconGeometry}" Fill="White" Stroke="White" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="LyricsPanel" Grid.Column="1" Margin="25,0,0,0" MaxWidth="980" RenderOptions.ClearTypeHint="Enabled">
                <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PanningDeceleration="0.0015" PanningRatio="0.85" ScrollChanged="LyricsScroll_ScrollChanged">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush x:Name="LyricsBottomFadeMask" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Black" Offset="0"/>
                            <GradientStop Color="Black" Offset="0.82"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <StackPanel x:Name="LyricsStack"/>
                </ScrollViewer>
                <TextBlock x:Name="EmptyStateText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Microsoft YaHei UI" FontSize="24" Foreground="#AFFFFFFF" TextAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Grid>

        <Grid x:Name="AuxiliaryControls" Panel.ZIndex="3" Margin="18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Button Style="{StaticResource GlassButton}" Content="&#xE711;" Click="Close_Click" ToolTip="退出沉浸歌词 (Esc)"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                <Button Style="{StaticResource GlassButton}" Content="&#xE767;" IsHitTestVisible="False" ToolTip="系统输出音量"/>
                <Slider x:Name="VolumeSlider" Style="{StaticResource ChromeSlider}" Width="150" Minimum="0" Maximum="1" VerticalAlignment="Center" PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown" ValueChanged="VolumeSlider_ValueChanged"/>
                <TextBlock x:Name="AudioStatusText" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                <Button x:Name="TranslationButton" Style="{StaticResource GlassButton}" Click="Translation_Click" ToolTip="显示/隐藏翻译"><Viewbox Width="23" Height="23"><Canvas Width="24" Height="24"><Path Data="M 4,7 L 12,7 M 8,4.5 L 8,7 M 5.2,9.2 C 6.2,11.4 9.2,13.1 12.2,13.8 M 11.8,9.2 C 10.6,12 7.9,13.7 5,14.5 M 13.5,18.5 L 17,9 L 20.5,18.5 M 14.8,15.2 L 19.2,15.2" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="SettingsToggleButton" Style="{StaticResource GlassButton}" Click="Settings_Click" ToolTip="字体和背景"><Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Data="M 4,6.5 L 20,6.5 M 4,12 L 20,12 M 4,17.5 L 20,17.5" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
            </StackPanel>
        </Grid>

        <Border x:Name="SettingsPanel" Panel.ZIndex="2" Visibility="Collapsed" Opacity="0" Width="390" MaxHeight="760" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,20,28,20" Padding="22" Background="#802C2C2E" BorderThickness="0" CornerRadius="22" RenderTransformOrigin="1,0.5">
            <Border.RenderTransform><TranslateTransform x:Name="SettingsPanelTransform" X="430"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect BlurRadius="35" ShadowDepth="8" Opacity="0.45"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12"><TextBlock Text="沉浸歌词外观" FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="SettingsCloseButton" HorizontalAlignment="Right" Style="{StaticResource SettingCircleButton}" Content="&#xE711;" Click="SettingsClose_Click" ToolTip="关闭设置"/></Grid>
                <ScrollViewer Grid.Row="1" Style="{StaticResource SettingScrollViewer}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,2,18">
                    <TextBlock Style="{StaticResource SettingLabel}" Text="预设"/>
                    <WrapPanel><Button Style="{StaticResource SettingButton}" Content="经典大字" Click="ClassicPreset_Click" Padding="12,7"/><Button Style="{StaticResource SettingButton}" Content="轻盈通透" Click="AiryPreset_Click" Padding="12,7" Margin="6,0"/></WrapPanel>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="原文中文字体"/><ComboBox x:Name="PrimaryChineseFontCombo" Style="{StaticResource SettingFontCombo}" SelectionChanged="SettingControl_Changed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="原文西文字体"/><ComboBox x:Name="PrimaryEnglishFontCombo" Style="{StaticResource SettingFontCombo}" SelectionChanged="SettingControl_Changed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="翻译字体"/><ComboBox x:Name="TranslationChineseFontCombo" Style="{StaticResource SettingFontCombo}" SelectionChanged="SettingControl_Changed"/>
                    <TextBlock x:Name="FontFallbackText" Margin="0,5,0,0" Foreground="#FFFFC76A" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="原文字号"/><Slider x:Name="PrimarySizeSlider" Style="{StaticResource SettingSlider}" Minimum="32" Maximum="96" TickFrequency="1" ValueChanged="SettingControl_Changed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="翻译字号"/><Slider x:Name="TranslationSizeSlider" Style="{StaticResource SettingSlider}" Minimum="16" Maximum="56" TickFrequency="1" ValueChanged="SettingControl_Changed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="原文字重"/><ComboBox x:Name="PrimaryWeightCombo" Style="{StaticResource SettingCombo}" SelectionChanged="SettingControl_Changed"><ComboBoxItem Tag="400">常规</ComboBoxItem><ComboBoxItem Tag="600">半粗</ComboBoxItem><ComboBoxItem Tag="700">粗体</ComboBoxItem></ComboBox>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="翻译字重"/><ComboBox x:Name="TranslationWeightCombo" Style="{StaticResource SettingCombo}" SelectionChanged="SettingControl_Changed"><ComboBoxItem Tag="300">细体</ComboBoxItem><ComboBoxItem Tag="400">常规</ComboBoxItem><ComboBoxItem Tag="600">半粗</ComboBoxItem></ComboBox>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="行距"/><Slider x:Name="LineHeightSlider" Style="{StaticResource SettingSlider}" Minimum="1.1" Maximum="1.6" TickFrequency="0.02" ValueChanged="SettingControl_Changed"/>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="背景模式"/><ComboBox x:Name="MotionModeCombo" Style="{StaticResource SettingCombo}" SelectionChanged="SettingControl_Changed"><ComboBoxItem Tag="Static">静态</ComboBoxItem><ComboBoxItem Tag="Ambient">氛围流动</ComboBoxItem><ComboBoxItem Tag="AudioReactive">音乐律动（系统输出）</ComboBoxItem></ComboBox>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="律动强度"/><ComboBox x:Name="IntensityCombo" Style="{StaticResource SettingCombo}" SelectionChanged="SettingControl_Changed"><ComboBoxItem Tag="Low">低</ComboBoxItem><ComboBoxItem Tag="Medium">中</ComboBoxItem><ComboBoxItem Tag="High">高</ComboBoxItem></ComboBox>
                    <TextBlock Style="{StaticResource SettingLabel}" Text="画质"/><ComboBox x:Name="QualityCombo" Style="{StaticResource SettingCombo}" SelectionChanged="SettingControl_Changed"><ComboBoxItem Tag="High60Fps">高画质 60fps</ComboBoxItem><ComboBoxItem Tag="Balanced30Fps">平衡 30fps</ComboBoxItem><ComboBoxItem Tag="Static">静态回退</ComboBoxItem></ComboBox>
                    <CheckBox x:Name="SongEasterEggsCheck" Style="{StaticResource SettingCheckBox}" Margin="0,14,0,0" Content="歌曲彩蛋" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed"/>
                    <CheckBox x:Name="ReduceMotionCheck" Style="{StaticResource SettingCheckBox}" Margin="0,14,0,0" Content="减少动态效果" Checked="SettingControl_Changed" Unchecked="SettingControl_Changed"/>
                    <TextBlock Margin="0,8,0,0" Foreground="#8FFFFFFF" FontSize="11" TextWrapping="Wrap" Text="音乐律动分析当前默认输出设备的系统混音，可能包含其他应用声音；仅在内存中计算能量，不保存或上传音频。"/>
                </StackPanel></ScrollViewer>
                <Border x:Name="SettingsActionsFooter" Grid.Row="2" Panel.ZIndex="2" Margin="-22,-22,-22,-22" Padding="22,34,22,18" CornerRadius="0,0,22,22">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#002C2C2E" Offset="0"/><GradientStop Color="#702C2C2E" Offset="0.38"/><GradientStop Color="#B02C2C2E" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource SettingButton}" Content="恢复默认" Click="ResetSettings_Click" Padding="14,8"/><Button Style="{StaticResource SettingButton}" Content="取消" Click="CancelSettings_Click" Padding="14,8" Margin="8,0"/><Button Style="{StaticResource SettingPrimaryButton}" Content="应用" Click="ApplySettings_Click" Padding="18,8"/></StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
