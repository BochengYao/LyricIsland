<UserControl x:Class="LyricHover.App.Modules.LyricsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LyricHover.App.Modules"
             Height="48"
             Background="Transparent"
             ClipToBounds="True">
    <Grid Margin="0,1,0,0" ClipToBounds="True">
        <StackPanel x:Name="CurrentLyricsPanel" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="CurrentLyricsTransform" />
            </StackPanel.RenderTransform>
            <Grid x:Name="PrimaryLyricClip" Height="21" ClipToBounds="True">
                <Canvas x:Name="PrimaryLyricCanvas" Height="21">
                    <StackPanel x:Name="PrimaryLyricLinePanel"
                                Canvas.Top="0"
                                Orientation="Horizontal">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PrimaryLyricTransform" />
                        </StackPanel.RenderTransform>
                        <local:WordTrackingTextBlock x:Name="PrimaryLyricText"
                                                     FontFamily="Microsoft YaHei UI"
                                                     FontSize="15"
                                                     LineHeight="18"
                                                     FontWeight="SemiBold"
                                                     Foreground="White"
                                                     DimOpacity="0.49"
                                                     TextAlignment="Left"
                                                     TextTrimming="None"
                                                     TextWrapping="NoWrap" />
                        <TextBlock x:Name="PrimaryAccentText"
                                   Margin="6,-1,0,0"
              FontFamily="/LyricHover.App;component/Assets/#Xiaolai"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD45C"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Canvas>
            </Grid>
            <Grid x:Name="SecondaryLyricClip" Height="15" ClipToBounds="True">
                <Canvas x:Name="SecondaryLyricCanvas" Height="15">
                    <TextBlock x:Name="SecondaryLyricText"
                               Canvas.Top="0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="11.25"
                               LineHeight="13"
                               Foreground="#ECFFFFFF"
                               TextAlignment="Left"
                               TextTrimming="None"
                               TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SecondaryLyricTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
        </StackPanel>
        <StackPanel x:Name="IncomingLyricsPanel" VerticalAlignment="Center" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="IncomingLyricsTransform" Y="10" />
            </StackPanel.RenderTransform>
            <Grid x:Name="IncomingPrimaryLyricClip" Height="21" ClipToBounds="True">
                <Canvas x:Name="IncomingPrimaryLyricCanvas" Height="21">
                    <StackPanel x:Name="IncomingPrimaryLyricLinePanel"
                                Canvas.Top="0"
                                Orientation="Horizontal">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="IncomingPrimaryLyricTextTransform" />
                        </StackPanel.RenderTransform>
                        <local:WordTrackingTextBlock x:Name="IncomingPrimaryLyricText"
                                                     FontFamily="Microsoft YaHei UI"
                                                     FontSize="15"
                                                     LineHeight="18"
                                                     FontWeight="SemiBold"
                                                     Foreground="White"
                                                     DimOpacity="0.49"
                                                     TextAlignment="Left"
                                                     TextTrimming="None"
                                                     TextWrapping="NoWrap" />
                        <TextBlock x:Name="IncomingPrimaryAccentText"
                                   Margin="6,-1,0,0"
              FontFamily="/LyricHover.App;component/Assets/#Xiaolai"
                                   FontSize="13.5"
                                   FontWeight="Bold"
                                   Foreground="#FFFFD45C"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Canvas>
            </Grid>
            <Grid x:Name="IncomingSecondaryLyricClip" Height="15" ClipToBounds="True">
                <Canvas x:Name="IncomingSecondaryLyricCanvas" Height="15">
                    <TextBlock x:Name="IncomingSecondaryLyricText"
                               Canvas.Top="0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="11.25"
                               LineHeight="13"
                               Foreground="#ECFFFFFF"
                               TextAlignment="Left"
                               TextTrimming="None"
                               TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="IncomingSecondaryLyricTextTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
