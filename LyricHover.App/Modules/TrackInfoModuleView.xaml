<UserControl x:Class="LyricHover.App.Modules.TrackInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="112"
             Height="48">
    <Grid Margin="4,0,10,0" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleViewport"
              Grid.Row="0"
              ClipToBounds="True">
            <TextBlock x:Name="TitleText"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextWrapping="NoWrap">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="TitleTextTransform" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </Grid>
        <TextBlock x:Name="ArtistText"
                   Grid.Row="1"
                   Margin="0,2,0,0"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="10.5"
                   Foreground="#B8FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
    </Grid>
</UserControl>
