<Window x:Class="LyricHover.App.WidgetsSettingsConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭小组件"
        Width="500" Height="278" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CornerRadiusResources.xaml" /></ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SettingsRootBackgroundBrush" Color="#F4F3FA" />
            <SolidColorBrush x:Key="SettingsControlBackgroundBrush" Color="#F8FAFC" />
            <SolidColorBrush x:Key="SettingsControlForegroundBrush" Color="#1F2937" />
            <SolidColorBrush x:Key="SettingsControlMutedForegroundBrush" Color="#667085" />
            <SolidColorBrush x:Key="SettingsControlBorderBrush" Color="#D8DEE8" />
            <SolidColorBrush x:Key="SettingsControlHoverBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SettingsControlPressedBackgroundBrush" Color="#EEF2F7" />
            <Style x:Key="SecondaryButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="110" /><Setter Property="Height" Value="40" /><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource SettingsControlForegroundBrush}" /><Setter Property="Background" Value="{DynamicResource SettingsControlBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SettingsControlHoverBackgroundBrush}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SettingsControlPressedBackgroundBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button"><Setter Property="MinWidth" Value="144" /><Setter Property="Height" Value="40" /><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#1677FF" /><Setter Property="BorderBrush" Value="#1677FF" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#0F6BEF" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#0B5FD7" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource SettingsRootBackgroundBrush}" BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusLarge}">
        <Border.Effect><DropShadowEffect BlurRadius="28" Color="#66000000" Direction="270" Opacity="0.26" ShadowDepth="8" /></Border.Effect>
        <Grid Margin="28,24,28,22"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="42" Height="42" Background="#1A0A84FF" CornerRadius="{StaticResource RadiusMedium}"><Path Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M12,2 C17.52,2 22,6.48 22,12 C22,17.52 17.52,22 12,22 C6.48,22 2,17.52 2,12 C2,6.48 6.48,2 12,2 Z M12,7 L12,13 M12,16 L12,16.2" Fill="Transparent" Stroke="#0A84FF" StrokeThickness="1.8" /></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource SettingsControlForegroundBrush}" Text="无法关闭小组件" /><TextBlock Margin="0,2,0,0" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="12" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" Text="歌词坞" /></StackPanel></Grid>
            <TextBlock Grid.Row="1" Margin="0,20,0,22" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" LineHeight="21" TextWrapping="Wrap" Text="系统阻止了后台修改。确认后将打开 Windows 任务栏设置，并自动关闭小组件。" />
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,12,0" Style="{StaticResource SecondaryButtonStyle}" Click="CancelButton_Click" Content="暂不关闭" /><Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click" Content="通过设置关闭" /></StackPanel>
        </Grid>
    </Border>
</Window>
