<Window x:Class="LyricHover.App.TaskbarLyricsConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认开启任务栏歌词"
        Width="520"
        Height="320"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsRootBackgroundBrush" Color="#F4F3FA" />
        <SolidColorBrush x:Key="SettingsControlBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="SettingsControlForegroundBrush" Color="#1F2937" />
        <SolidColorBrush x:Key="SettingsControlMutedForegroundBrush" Color="#667085" />
        <SolidColorBrush x:Key="SettingsControlBorderBrush" Color="#D8DEE8" />
        <SolidColorBrush x:Key="SettingsControlHoverBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SettingsControlPressedBackgroundBrush" Color="#EEF2F7" />
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SettingsControlForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource SettingsControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="14,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource SettingsControlHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource SettingsControlPressedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="BorderBrush" Value="#1677FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="14,0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#0F6BEF" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#0F6BEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#0B5FD7" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#0B5FD7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SettingsRootBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              Color="#66000000"
                              Direction="270"
                              Opacity="0.26"
                              ShadowDepth="8" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border Width="42"
                        Height="42"
                        Background="#1A1677FF"
                        CornerRadius="14">
                    <Path Width="22"
                          Height="22"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M12,3 L22,21 H2 Z M12,9 V14 M12,17 V17.2"
                          Fill="Transparent"
                          Stroke="#1677FF"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.8"
                          Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontFamily="Microsoft YaHei UI"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsControlForegroundBrush}"
                               Text="确认开启任务栏歌词" />
                    <TextBlock Margin="0,3,0,0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="12"
                               Foreground="{DynamicResource SettingsControlMutedForegroundBrush}"
                               Text="LyricHover 任务栏歌词功能" />
                </StackPanel>
                <Button Grid.Column="3"
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CancelButton_Click"
                        Content="×"
                        FontFamily="Segoe UI"
                        FontSize="24"
                        Foreground="{DynamicResource SettingsControlMutedForegroundBrush}"
                        ToolTip="取消" />
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,22,0,20"
                    Padding="18,16"
                    Background="{DynamicResource SettingsControlBackgroundBrush}"
                    BorderBrush="{DynamicResource SettingsControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SettingsControlForegroundBrush}"
                               Text="任务栏歌词会临时隐藏系统小组件" />
                    <TextBlock Margin="0,7,0,0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="13"
                               Foreground="{DynamicResource SettingsControlMutedForegroundBrush}"
                               LineHeight="20"
                               LineStackingStrategy="BlockLineHeight"
                               Text="这是全局任务栏设置。关闭任务栏歌词、正常退出或下次启动时会恢复原状态。仅在所选屏幕具备安全空间时显示，可随时关闭并自动恢复。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CancelButton_Click"
                        Content="取消" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="ConfirmButton_Click"
                        Content="确认开启" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
