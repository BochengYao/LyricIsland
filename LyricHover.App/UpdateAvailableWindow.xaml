<Window x:Class="LyricHover.App.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Width="620"
        Height="610"
        MinHeight="480"
        MaxHeight="760"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CornerRadiusResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SettingsRootBackgroundBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="SettingsControlBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SettingsControlForegroundBrush" Color="#1D1D1F" />
            <SolidColorBrush x:Key="SettingsControlMutedForegroundBrush" Color="#6E6E73" />
            <SolidColorBrush x:Key="SettingsControlBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="SettingsControlHoverBackgroundBrush" Color="#F5F5F7" />
            <SolidColorBrush x:Key="SettingsControlPressedBackgroundBrush" Color="#E8E8ED" />

            <Style x:Key="UpdateSecondaryButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="190" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SettingsControlForegroundBrush}" />
                <Setter Property="Background" Value="{DynamicResource SettingsControlBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusSmall}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SettingsControlHoverBackgroundBrush}" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource SettingsControlPressedBackgroundBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="UpdatePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource UpdateSecondaryButtonStyle}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#1677FF" />
                <Setter Property="BorderBrush" Value="#1677FF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusSmall}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#0F6BEF" /><Setter TargetName="Root" Property="BorderBrush" Value="#0F6BEF" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#0B5FD7" /><Setter TargetName="Root" Property="BorderBrush" Value="#0B5FD7" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource SettingsRootBackgroundBrush}"
            BorderBrush="{DynamicResource SettingsControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" Color="#66000000" Direction="270" Opacity="0.28" ShadowDepth="10" />
        </Border.Effect>
        <Grid Margin="30,26,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" Background="#191677FF" CornerRadius="{StaticResource RadiusMedium}">
                    <Path Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M12,3 L12,16 M7,11 L12,16 L17,11 M5,21 L19,21"
                          Fill="Transparent" Stroke="#1677FF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleTextBlock" FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource SettingsControlForegroundBrush}" Text="发现新版本" />
                    <TextBlock x:Name="SubtitleTextBlock" Margin="0,3,0,0" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" />
                </StackPanel>
                <Button Grid.Column="3" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" Content="×" FontFamily="Segoe UI" FontSize="22" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" ToolTip="Close" />
            </Grid>

            <TextBlock x:Name="LeadTextBlock" Grid.Row="1" Margin="0,24,0,14" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource SettingsControlForegroundBrush}" Text="本次更新内容" />

            <Border Grid.Row="2" Padding="20,8,12,8" Background="{DynamicResource SettingsControlBackgroundBrush}" BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,8,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="#1677FF" Text="•" />
                                    <TextBlock Grid.Column="1" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="14" LineHeight="22" Foreground="{DynamicResource SettingsControlForegroundBrush}" Text="{Binding}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button x:Name="DetailsButton" Grid.Column="0" Style="{StaticResource UpdateSecondaryButtonStyle}" Click="DetailsButton_Click" Content="查看详情" />
                <Button x:Name="StoreButton" Grid.Column="2" Style="{StaticResource UpdatePrimaryButtonStyle}" Click="StoreButton_Click" Content="立即更新" />
            </Grid>
        </Grid>
    </Border>
</Window>
