                                                    Style="{StaticResource TextLinkButtonStyle}"
                                                    Click="OpenWebsiteAboutRow_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               FontSize="13"
                                                               Text="打开官网" />
                                                    <Path Width="12"
                                                          Height="12"
                                                          Margin="7,1,0,0"
                                                          Data="M1,11 L11,1 M4,1 H11 V8"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Square"
                                                          StrokeEndLineCap="Square"
                                                          StrokeLineJoin="Miter" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <Border Grid.Row="1" Style="{StaticResource AboutDividerStyle}" />

                                        <Grid x:Name="AboutGitHubRow"
                                              Grid.Row="2"
                                              Margin="10,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="22"
                                                         Height="22"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center">
                                                    <Path Data="M12,.7 A11.3,11.3 0 0 0 8.4,22.7 C9,22.8 9.2,22.4 9.2,22.1 V19.9 C5.9,20.6 5.2,18.5 5.2,18.5 C4.7,17.2 4,16.9 4,16.9 C3,16.2 4.1,16.2 4.1,16.2 C5.2,16.3 5.8,17.4 5.8,17.4 C6.8,19.1 8.5,18.6 9.2,18.3 C9.3,17.6 9.6,17.1 9.9,16.8 C7.2,16.5 4.4,15.5 4.4,11 C4.4,9.7 4.9,8.7 5.6,7.9 C5.5,7.6 5.1,6.3 5.7,4.8 C5.7,4.8 6.7,4.5 8.9,6 C9.8,5.7 10.8,5.6 12,5.6 C13.1,5.6 14.2,5.7 15.1,6 C17.3,4.5 18.3,4.8 18.3,4.8 C18.9,6.3 18.5,7.6 18.4,7.9 C19.1,8.7 19.6,9.7 19.6,11 C19.6,15.5 16.8,16.5 14.1,16.8 C14.5,17.2 14.8,17.8 14.8,18.8 V22.1 C14.8,22.5 15,22.8 15.6,22.7 A11.3,11.3 0 0 0 12,.7"
                                                          Fill="{DynamicResource SettingsControlMutedForegroundBrush}"
                                                          Stretch="Uniform" />
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource AboutActionTitleStyle}" Text="GitHub 项目主页" />
                                                    <TextBlock Style="{StaticResource AboutActionDescriptionStyle}" Text="查看源代码、版本记录和问题反馈" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource TextLinkButtonStyle}"
                                                        Click="OpenGitHubAboutRow_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="OpenGitHubLinkText"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               FontSize="13"
                                                               Text="打开 GitHub" />
                                                    <Path x:Name="OpenGitHubLinkArrow"
                                                          Width="12"
                                                          Height="12"
                                                          Margin="7,1,0,0"
                                                          Data="M1,11 L11,1 M4,1 H11 V8"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Square"
                                                          StrokeEndLineCap="Square"
                                                          StrokeLineJoin="Miter" />
                                                    </StackPanel>
                                                </Button>
                                        </Grid>
                                        <Border Grid.Row="3" Style="{StaticResource AboutDividerStyle}" />

                                        <Grid x:Name="AboutTutorialRow"
                                              Grid.Row="4"
                                              Margin="10,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="46" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="22"
                                                         Height="22"
                                                         HorizontalAlignment="Left"
                                                         VerticalAlignment="Center">
                                                    <Path Data="M1,8 L12,2 L23,8 L12,14 Z M5,10 V16 C9,20 15,20 19,16 V10 M23,8 V15"
                                                          Fill="Transparent"
                                                          Stroke="{DynamicResource SettingsControlMutedForegroundBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round" />
                                                </Viewbox>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource AboutActionTitleStyle}" Text="教学模式" />
                                                    <TextBlock Style="{StaticResource AboutActionDescriptionStyle}" Text="重新显示首次使用教学流程" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource TextLinkButtonStyle}"
                                                        Click="RestartTutorialAboutRow_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                   FontSize="13"
                                                                   Text="重新开始教学" />
                                                        <Path Width="7"
                                                              Height="12"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Data="M1,1 L6,6 L1,11"
                                                              Stretch="Uniform"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round" />
                                                    </StackPanel>
                                                </Button>
                                        </Grid>
                                        <Border Grid.Row="5" Style="{StaticResource AboutDividerStyle}" />
                                    </Grid>

                                    <StackPanel x:Name="AboutUpdateSection"
                                                Grid.Row="4"
                                                MaxWidth="680"
                                                Margin="2,0,0,0"
                                                HorizontalAlignment="Left">
                                        <TextBlock FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Text="v2.0 更新内容" />
                                        <StackPanel Margin="0,8,0,0">
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" Text="•" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" TextWrapping="Wrap" Text="新增水平积木与自动折叠两种LyricHover布局" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" Text="•" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" TextWrapping="Wrap" Text="支持拖动添加、排序与删除封面、歌词、控制、信息、进度和分割线模块" />
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" Text="•" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" TextWrapping="Wrap" Text="支持 Apple Music、QQ 音乐、网易云、酷狗、酷我、Spotify 等 SMTC 播放器" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" Text="•" />
                                                <TextBlock Grid.Column="1" Foreground="{DynamicResource SettingsControlMutedForegroundBrush}" FontSize="13" TextWrapping="Wrap" Text="新增同步歌词缓存、播放器锁定、鼠标避让、快捷键和主题设置" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border x:Name="AboutBottomDivider"
                                             Grid.Row="5"
                                             Margin="0,14,0,0"
                                             Style="{StaticResource AboutDividerStyle}" />
                                    <TextBlock Grid.Row="6"
                                               Margin="0,10,0,4"
                                               Foreground="{DynamicResource SettingsControlMutedForegroundBrush}"
                                               FontSize="12"
                                               Text="© 2026 大丞子 · 感谢参与 v2.0 测试" />
                                    <TextBlock Grid.Row="6" Text="软件著作权" Visibility="Collapsed" />
                                    <TextBlock Grid.Row="6" Text="申请中" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        </Border>
                        </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Panel.ZIndex="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="112"
                        Padding="20,0"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"
                        IsCancel="True"
                        Visibility="Collapsed"
                        Content="取消" />
                <Button x:Name="ApplyButton"
                        MinWidth="112"
                        Padding="20,0"
                        Margin="0,0,8,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="ApplyButton_Click"
                        Visibility="Collapsed"
                        Content="应用" />
                <Button x:Name="SaveButton"
                        Padding="28,0"
                        IsDefault="True"
                        Style="{StaticResource SettingsDoneButtonStyle}"
                        Click="SaveButton_Click"
                        Content="完成" />
            </StackPanel>

        </Grid>
    </Border>

</Window>

