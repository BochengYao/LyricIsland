<UserControl x:Class="AppleMusicDesktopLyrics.App.Modules.LyricsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="48"
             ClipToBounds="True">
    <Grid Margin="0,1,0,0" ClipToBounds="True">
        <StackPanel x:Name="CurrentLyricsPanel" VerticalAlignment="Center">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="CurrentLyricsTransform" />
            </StackPanel.RenderTransform>
            <Grid x:Name="PrimaryLyricClip" Height="18" ClipToBounds="True">
                <Canvas x:Name="PrimaryLyricCanvas" Height="18">
                    <TextBlock x:Name="PrimaryLyricText"
                               Canvas.Top="0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               LineHeight="18"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextAlignment="Left"
                               TextTrimming="None"
                               TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="PrimaryLyricTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
            <Grid x:Name="SecondaryLyricClip" Height="13" ClipToBounds="True">
                <Canvas x:Name="SecondaryLyricCanvas" Height="13">
                    <TextBlock x:Name="SecondaryLyricText"
                               Canvas.Top="0"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="10.5"
                               LineHeight="13"
                               Foreground="#D9FFFFFF"
                               TextAlignment="Left"
                               TextTrimming="None"
                               TextWrapping="NoWrap">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SecondaryLyricTransform" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Canvas>
            </Grid>
        </StackPanel>
        <StackPanel x:Name="IncomingLyricsPanel" VerticalAlignment="Center" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="IncomingLyricsTransform" Y="10" />
            </StackPanel.RenderTransform>
            <TextBlock x:Name="IncomingPrimaryLyricText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="15"
                       LineHeight="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextAlignment="Center"
                       TextTrimming="None"
                       TextWrapping="NoWrap" />
            <TextBlock x:Name="IncomingSecondaryLyricText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="10.5"
                       LineHeight="13"
                       Foreground="#D9FFFFFF"
                       TextAlignment="Center"
                       TextTrimming="None"
                       TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</UserControl>
