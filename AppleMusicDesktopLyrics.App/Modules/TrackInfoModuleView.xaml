<UserControl x:Class="AppleMusicDesktopLyrics.App.Modules.TrackInfoModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="168"
             Height="44">
    <StackPanel VerticalAlignment="Center" Margin="4,0,10,0">
        <TextBlock x:Name="TitleText"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="White"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
        <TextBlock x:Name="ArtistText"
                   Margin="0,3,0,0"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="10.5"
                   Foreground="#B8FFFFFF"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap" />
    </StackPanel>
</UserControl>
