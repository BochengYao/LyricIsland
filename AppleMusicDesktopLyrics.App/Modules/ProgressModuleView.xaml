<UserControl x:Class="AppleMusicDesktopLyrics.App.Modules.ProgressModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="148"
             Height="48">
    <StackPanel VerticalAlignment="Center" Margin="6,0,10,0">
        <ProgressBar x:Name="ProgressBar"
                     Height="3"
                     Minimum="0"
                     Maximum="1"
                     Value="0"
                     Foreground="#FFFFFFFF"
                     Background="#36FFFFFF"
                     BorderThickness="0" />
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PositionText"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="9.5"
                       Foreground="#B8FFFFFF"
                       Text="0:00" />
            <TextBlock x:Name="DurationText"
                       Grid.Column="1"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="9.5"
                       Foreground="#B8FFFFFF"
                       TextAlignment="Right"
                       Text="0:00" />
        </Grid>
    </StackPanel>
</UserControl>
