<UserControl x:Class="AppleMusicDesktopLyrics.App.Modules.AlbumArtModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48"
             Height="48">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="NeutralArtworkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#303030" Offset="0" />
            <GradientStop Color="#141414" Offset="1" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <Border x:Name="ArtworkFrame"
            Width="42"
            Height="42"
            CornerRadius="10"
            Background="{StaticResource NeutralArtworkBrush}"
            ClipToBounds="True">
        <Image x:Name="ArtworkImage"
               Stretch="UniformToFill"
               SnapsToDevicePixels="True" />
    </Border>
</UserControl>
