<UserControl x:Class="AppleMusicDesktopLyrics.App.Modules.PlaybackControlsModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="144"
             Height="48">
    <UserControl.Resources>
        <Style x:Key="PlaybackIconButtonStyle" TargetType="Button">
          <Setter Property="Width" Value="44" />
          <Setter Property="Height" Value="40" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border x:Name="HitBackground" Background="Transparent" CornerRadius="10">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HitBackground" Property="Background" Value="#24FFFFFF" />
                  </Trigger>
                  <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="HitBackground" Property="Background" Value="#3DFFFFFF" />
                    <Setter TargetName="HitBackground" Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter TargetName="HitBackground" Property="RenderTransform">
                      <Setter.Value><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Setter.Value>
                    </Setter>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.28" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Button x:Name="PreviousButton"
                Style="{StaticResource PlaybackIconButtonStyle}"
                Click="PreviousButton_Click"
                MouseEnter="Button_MouseEnter"
                MouseLeave="Button_MouseLeave"
                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">
            <Path Width="28" Height="22" Stretch="Fill" Fill="White" Data="M 0,11 L 12,3 L 12,8 L 27,0 L 27,22 L 12,14 L 12,19 Z" />
        </Button>
        <Button x:Name="PlayPauseButton"
                Style="{StaticResource PlaybackIconButtonStyle}"
                Click="PlayPauseButton_Click"
                MouseEnter="Button_MouseEnter"
                MouseLeave="Button_MouseLeave"
                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">
            <Grid x:Name="PlayPauseGlyph" Width="18" Height="22">
                <Path x:Name="PlayGlyph" Width="18" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="White" Data="M 0,0 L 18,11 L 0,22 Z" Visibility="Collapsed" />
                <StackPanel x:Name="PauseGlyph" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="5" Height="22" CornerRadius="2" Background="White" />
                    <Border Width="5" Height="22" Margin="4,0,0,0" CornerRadius="2" Background="White" />
                </StackPanel>
            </Grid>
        </Button>
        <Button x:Name="NextButton"
                Style="{StaticResource PlaybackIconButtonStyle}"
                Click="NextButton_Click"
                MouseEnter="Button_MouseEnter"
                MouseLeave="Button_MouseLeave"
                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">
            <Path Width="28" Height="22" Stretch="Fill" Fill="White" Data="M 0,0 L 15,8 L 15,3 L 28,11 L 15,19 L 15,14 L 0,22 Z" />
        </Button>
    </StackPanel>
</UserControl>
