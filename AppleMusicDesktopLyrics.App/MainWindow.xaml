<Window x:Class="AppleMusicDesktopLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple Music Desktop Lyrics"
        Width="560"
        Height="60"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove"
        MouseRightButtonDown="Window_MouseRightButtonDown">
    <Grid x:Name="IslandShell"
          Width="560"
          Height="60"
          SnapsToDevicePixels="True">
        <Path x:Name="IslandShape"
              Stretch="None"
              Data="M 0,0 L 560,0 C 532,0 522,5 516,15 C 512,22 512,34 512,40 C 512,49 504,55 491,55 L 69,55 C 56,55 48,49 48,40 C 48,34 48,22 44,15 C 38,5 28,0 0,0 Z">
            <Path.Fill>
                <SolidColorBrush x:Name="IslandBackground" Color="#FF000000" />
            </Path.Fill>
        </Path>
        <Grid x:Name="LyricsContent"
              Margin="62,6,62,7"
              ClipToBounds="True">
            <StackPanel x:Name="CurrentLyricsPanel"
                        VerticalAlignment="Center">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="CurrentLyricsTransform" />
                </StackPanel.RenderTransform>
                <Grid x:Name="PrimaryLyricClip"
                      Height="18"
                      ClipToBounds="True">
                    <Canvas x:Name="PrimaryLyricCanvas"
                            Height="18">
                        <TextBlock x:Name="PrimaryLyricText"
                                   Text=""
                                   Canvas.Top="0"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="15"
                                   LineHeight="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextAlignment="Left"
                                   TextTrimming="None"
                                   TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="PrimaryLyricTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>
                <Grid x:Name="SecondaryLyricClip"
                      Height="13"
                      ClipToBounds="True">
                    <Canvas x:Name="SecondaryLyricCanvas"
                            Height="13">
                        <TextBlock x:Name="SecondaryLyricText"
                                   Text=""
                                   Canvas.Top="0"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="10.5"
                                   LineHeight="13"
                                   FontWeight="Normal"
                                   Foreground="#D9FFFFFF"
                                   TextAlignment="Left"
                                   TextTrimming="None"
                                   TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="SecondaryLyricTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="IncomingLyricsPanel"
                        VerticalAlignment="Center"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="IncomingLyricsTransform" Y="10" />
                </StackPanel.RenderTransform>
                <TextBlock x:Name="IncomingPrimaryLyricText"
                           Text=""
                           FontFamily="Microsoft YaHei UI"
                           FontSize="15"
                           LineHeight="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Center"
                           TextTrimming="None"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="IncomingSecondaryLyricText"
                           Text=""
                           FontFamily="Microsoft YaHei UI"
                           FontSize="10.5"
                           LineHeight="13"
                           FontWeight="Normal"
                           Foreground="#D9FFFFFF"
                           TextAlignment="Center"
                           TextTrimming="None"
                           TextWrapping="NoWrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
