<Window x:Class="AppleMusicDesktopLyrics.App.PlacementSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="偏好设置"
        Width="760"
        Height="760"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Icon="Assets/app-logo.png"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#202124" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#E6E9EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="SidebarButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SidebarRoot"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarRoot" Property="Background" Value="#F2F5FA" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SidebarRoot" Property="Background" Value="#EAF2FF" />
                                <Setter Property="Foreground" Value="#0F5FD7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D6DCE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#EEF2F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1677FF" />
            <Setter Property="BorderBrush" Value="#1677FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#0F6BEF" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#0F6BEF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonRoot" Property="Background" Value="#0B5FD7" />
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="#0B5FD7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TextBoxRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxRoot" Property="BorderBrush" Value="#1677FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="#D8DEE8"
                                                BorderThickness="1"
                                                CornerRadius="9">
                                            <Grid>
                                                <ContentPresenter Margin="11,0,34,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}" />
                                                <Path HorizontalAlignment="Right"
                                                      Margin="0,0,13,0"
                                                      VerticalAlignment="Center"
                                                      Fill="#667085"
                                                      Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboRoot" Property="Background" Value="#FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="White"
                                        BorderBrush="#D8DEE8"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer MaxHeight="220">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="Transparent"
                                CornerRadius="7">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#EAF2FF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#EAF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckRoot"
                                    Width="19"
                                    Height="19"
                                    Background="#FFFFFF"
                                    BorderBrush="#CBD3DF"
                                    BorderThickness="1.4"
                                    CornerRadius="6">
                                <Path x:Name="CheckGlyph"
                                      Width="11"
                                      Height="8"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Data="M 1,4 L 4.2,7 L 10,1"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckRoot" Property="Background" Value="#1677FF" />
                                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#1677FF" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckRoot" Property="BorderBrush" Value="#1677FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30"
                              VerticalAlignment="Center">
                            <Track x:Name="PART_Track"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#1677FF"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5"
                                                        Background="#E6EAF0"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18"
                                           Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbRoot"
                                                        Background="#FFFFFF"
                                                        BorderBrush="#C8D1DC"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="7"
                                                                          Direction="270"
                                                                          Opacity="0.18"
                                                                          ShadowDepth="1" />
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="#1677FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbRoot" Property="BorderBrush" Value="#1677FF" />
                                                        <Setter TargetName="ThumbRoot" Property="Background" Value="#F8FAFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentRoot" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="SegmentRoot" Property="BorderBrush" Value="#D5DCE7" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#F7F8FB"
            BorderBrush="#D4DAE3"
            BorderThickness="1"
            CornerRadius="18">
        <Grid Margin="28,24,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,18"
                        Orientation="Horizontal">
                <Border Width="42"
                        Height="42"
                        Margin="0,0,12,0"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Image Source="Assets/app-logo.png"
                           Stretch="UniformToFill" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Text="偏好设置" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="#7A8494"
                               FontSize="12"
                               Text="调整歌词岛位置、缓存和鼠标避让效果" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1"
                  Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="184" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <RadioButton x:Name="LyricsSectionButton"
                                     GroupName="SettingsSection"
                                     Tag="Lyrics"
                                     Checked="SectionButton_Checked"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Content="歌词显示" />
                        <RadioButton x:Name="PositionSectionButton"
                                     GroupName="SettingsSection"
                                     Tag="Position"
                                     Checked="SectionButton_Checked"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Content="位置" />
                        <RadioButton x:Name="CacheSectionButton"
                                     GroupName="SettingsSection"
                                     Tag="Cache"
                                     Checked="SectionButton_Checked"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Content="缓存" />
                        <RadioButton x:Name="HoverSectionButton"
                                     GroupName="SettingsSection"
                                     Tag="Hover"
                                     Checked="SectionButton_Checked"
                                     Style="{StaticResource SidebarButtonStyle}"
                                     Content="鼠标避让" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid x:Name="LyricsSettingsPanel">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,22"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="歌词显示" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,16,16"
                                       Style="{StaticResource SettingLabel}"
                                       Text="首选歌词源" />
                            <ComboBox x:Name="LyricsSourceComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,0,0,16"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Value" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,16,16"
                                       Style="{StaticResource SettingLabel}"
                                       Text="行数" />
                            <Border Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,0,16"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    Background="#EEF1F6"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SingleLineRadioButton"
                                                 GroupName="LineMode"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 Content="单行" />
                                    <RadioButton x:Name="MultiLineRadioButton"
                                                 GroupName="LineMode"
                                                 Style="{StaticResource SegmentButtonStyle}"
                                                 Content="多行" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Style="{StaticResource SettingLabel}"
                                       Text="翻译" />
                            <CheckBox x:Name="ShowTranslationCheckBox"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Checked="ShowTranslationCheckBox_Changed"
                                      Unchecked="ShowTranslationCheckBox_Changed"
                                      Content="显示歌词库里的中文翻译" />
                        </Grid>

                        <Grid x:Name="PositionSettingsPanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,0,0,22"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="位置" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,16,16"
                                       Style="{StaticResource SettingLabel}"
                                       Text="显示器" />
                            <ComboBox x:Name="ScreenComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,0,16"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Name" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Style="{StaticResource SettingLabel}"
                                       Text="边缘位置" />
                            <Slider x:Name="OffsetSlider"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="False" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Style="{StaticResource SettingValue}"
                                       Text="上方" />
                        </Grid>

                        <Grid x:Name="CacheSettingsPanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0,0,0,22"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="缓存" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource SettingLabel}"
                                       Text="缓存容量" />
                            <DockPanel Grid.Row="1"
                                       Grid.Column="1"
                                       LastChildFill="False">
                                <TextBox x:Name="CacheLimitTextBox"
                                         Width="118"
                                         TextAlignment="Center" />
                                <TextBlock Margin="8,0,0,0"
                                           Style="{StaticResource SettingLabel}"
                                           Text="MB" />
                            </DockPanel>
                        </Grid>

                        <Grid x:Name="HoverSettingsPanel"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="3"
                                       Margin="0,0,0,22"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="鼠标避让" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="光晕大小" />
                            <Slider x:Name="HoverAuraSizeSlider"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="40"
                                    Maximum="220"
                                    TickFrequency="10"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="HoverAuraSizeValueText"
                                       Grid.Row="1"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="探测范围" />
                            <Slider x:Name="HoverDetectionRangeSlider"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="60"
                                    Maximum="640"
                                    TickFrequency="20"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="HoverDetectionRangeValueText"
                                       Grid.Row="2"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="光晕形状" />
                            <Slider x:Name="HoverAuraAspectRatioSlider"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="0.8"
                                    Maximum="2.0"
                                    TickFrequency="0.05"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="HoverAuraAspectRatioValueText"
                                       Grid.Row="3"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="实时预览" />
                            <Border Grid.Row="4"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Height="118"
                                    Margin="0,0,0,18"
                                    Background="#15171C"
                                    BorderBrush="#E6EAF0"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                <Grid ClipToBounds="True">
                                    <Grid Margin="16,14,16,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0"
                                                   Foreground="#E5E7EB"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="底层内容预览" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,5,0,0"
                                                   Foreground="#B8C0CC"
                                                   FontSize="10.5"
                                                   Text="Microsoft 合作伙伴中心  /  管理包  /  Package validation" />
                                        <Grid Grid.Row="2"
                                              Margin="0,11,0,0">
                                            <TextBlock HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       Foreground="#E5E7EB"
                                                       FontSize="11"
                                                       Text="软件包验证   提交前运行验证检查，定位并修复错误" />
                                            <TextBlock HorizontalAlignment="Left"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="#9CA3AF"
                                                       FontSize="10"
                                                       Text="包 ID        体系结构        已修改        验证状态" />

                                            <Border x:Name="HoverPreviewIsland"
                                                    Width="372"
                                                    Height="52"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#000000"
                                                    CornerRadius="22">
                                                <Border.OpacityMask>
                                                    <RadialGradientBrush x:Name="HoverPreviewAura"
                                                                         MappingMode="Absolute"
                                                                         Center="186,26"
                                                                         GradientOrigin="186,26"
                                                                         RadiusX="70"
                                                                         RadiusY="50">
                                                        <GradientStop x:Name="HoverPreviewCenterStop"
                                                                      Offset="0"
                                                                      Color="#40FFFFFF" />
                                                        <GradientStop x:Name="HoverPreviewMidStop"
                                                                      Offset="0.58"
                                                                      Color="#B0FFFFFF" />
                                                        <GradientStop x:Name="HoverPreviewEdgeStop"
                                                                      Offset="1"
                                                                      Color="#FFFFFFFF" />
                                                    </RadialGradientBrush>
                                                </Border.OpacityMask>
                                                <Grid ClipToBounds="True">
                                                    <StackPanel HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="歌词光影预览" />
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0"
                                                                   Foreground="#D7DCE5"
                                                                   FontSize="9.5"
                                                                   Text="鼠标附近会变淡，底下文字应能看清" />
                                                    </StackPanel>
                                                   <Ellipse x:Name="HoverShapePreviewEllipse"
                                                             Width="112"
                                                             Height="64"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Fill="Transparent"
                                                             IsHitTestVisible="False"
                                                             Opacity="0.55"
                                                             Stroke="#88FFFFFF"
                                                             StrokeThickness="1" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="5"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="光晕频谱" />
                            <StackPanel Grid.Row="5"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,0,0,18">
                                <Border Height="24"
                                        CornerRadius="12"
                                        BorderBrush="#D8DEE8"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5"
                                                             EndPoint="1,0.5">
                                            <GradientStop x:Name="SpectrumCenterPreviewStop"
                                                          Offset="0"
                                                          Color="#1F1677FF" />
                                            <GradientStop x:Name="SpectrumMidPreviewStop"
                                                          Offset="0.46"
                                                          Color="#751677FF" />
                                            <GradientStop x:Name="SpectrumEdgePreviewStop"
                                                          Offset="1"
                                                          Color="#FFFFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock HorizontalAlignment="Left"
                                               Foreground="#98A2B3"
                                               FontSize="11"
                                               Text="中心" />
                                    <TextBlock x:Name="SpectrumMidPositionValueText"
                                               HorizontalAlignment="Center"
                                               Foreground="#98A2B3"
                                               FontSize="11" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Foreground="#98A2B3"
                                               FontSize="11"
                                               Text="边缘" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Grid.Row="6"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="过渡位置" />
                            <Slider x:Name="SpectrumMidPositionSlider"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="5"
                                    Maximum="95"
                                    TickFrequency="5"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="SpectrumMidPositionSliderValueText"
                                       Grid.Row="6"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="7"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="中心透明" />
                            <Slider x:Name="SpectrumCenterTransparencySlider"
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="SpectrumCenterTransparencyValueText"
                                       Grid.Row="7"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="8"
                                       Grid.Column="0"
                                       Margin="0,0,16,18"
                                       Style="{StaticResource SettingLabel}"
                                       Text="过渡透明" />
                            <Slider x:Name="SpectrumMidTransparencySlider"
                                    Grid.Row="8"
                                    Grid.Column="1"
                                    Margin="0,0,10,18"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="SpectrumMidTransparencyValueText"
                                       Grid.Row="8"
                                       Grid.Column="2"
                                       Margin="0,0,0,18"
                                       Style="{StaticResource SettingValue}" />

                            <TextBlock Grid.Row="9"
                                       Grid.Column="0"
                                       Style="{StaticResource SettingLabel}"
                                       Text="边缘透明" />
                            <Slider x:Name="SpectrumEdgeTransparencySlider"
                                    Grid.Row="9"
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    Minimum="0"
                                    Maximum="100"
                                    TickFrequency="5"
                                    ValueChanged="SettingSlider_ValueChanged" />
                            <TextBlock x:Name="SpectrumEdgeTransparencyValueText"
                                       Grid.Row="9"
                                       Grid.Column="2"
                                       Style="{StaticResource SettingValue}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Click="ApplyButton_Click"
                        Content="应用" />
                <Button Margin="0,0,8,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SaveButton_Click"
                        Content="保存" />
                <Button Click="CancelButton_Click"
                        IsCancel="True"
                        Content="取消" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
