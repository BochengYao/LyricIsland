SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=lyric-island-submissions
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_SECRET=replace-with-at-least-24-random-characters

# Use a separate Supabase project and key for supporter/payment data.
SUPPORT_SUPABASE_URL=https://your-support-project.supabase.co
SUPPORT_SUPABASE_SERVICE_ROLE_KEY=replace-with-dedicated-server-only-service-role-key
# Generate independent random keys; do not reuse either value elsewhere.
SUPPORT_DATA_ENCRYPTION_KEY_BASE64=replace-with-32-random-bytes-in-base64
SUPPORT_LOOKUP_HMAC_KEY_BASE64=replace-with-at-least-32-random-bytes-in-base64

# Future supporter checkout integration. Keep private keys server-only.
WECHAT_PAY_MERCHANT_ID=replace-after-merchant-approval
WECHAT_PAY_APP_ID=replace-after-merchant-approval
WECHAT_PAY_API_V3_KEY=replace-with-server-only-key
WECHAT_PAY_PRIVATE_KEY=replace-with-server-only-private-key
ALIPAY_APP_ID=replace-after-app-approval
ALIPAY_PRIVATE_KEY=replace-with-server-only-private-key
ALIPAY_PUBLIC_KEY=replace-with-alipay-public-key
SUPPORT_EMAIL_PROVIDER_API_KEY=replace-after-email-provider-setup
